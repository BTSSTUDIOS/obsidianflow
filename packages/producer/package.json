{
  "name": "@obsidianflow/producer",
  "version": "0.1.0",
  "description": "FFmpeg video encoding and audio mixing pipeline for OBSIDIAN FLOW",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btsstudios/obsidianflow.git",
    "directory": "packages/producer"
  },
  "homepage": "https://github.com/btsstudios/obsidianflow#readme",
  "bugs": {
    "url": "https://github.com/btsstudios/obsidianflow/issues"
  },
  "keywords": [
    "obsidianflow",
    "producer",
    "ffmpeg",
    "encoder",
    "audio-mixing",
    "sidechain-ducking"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "node --test dist/**/*.test.js || true"
  },
  "dependencies": {
    "@obsidianflow/core": "^0.1.0",
    "@obsidianflow/engine": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "author": "BIDKAR RAMOS <bidkar@gulp.wtf>",
  "license": "Apache-2.0"
}
