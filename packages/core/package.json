{
  "name": "@obsidianflow/core",
  "version": "0.1.0",
  "description": "Core composition parser, linter, seekable runtime, and adapters for OBSIDIAN FLOW",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btsstudios/obsidianflow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/btsstudios/obsidianflow#readme",
  "bugs": {
    "url": "https://github.com/btsstudios/obsidianflow/issues"
  },
  "keywords": [
    "obsidianflow",
    "video",
    "rendering",
    "agent-skills",
    "html",
    "css",
    "animation",
    "remotion",
    "hyperframes"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    },
    "./runtime.js": "./dist/runtime.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "node --test dist/**/*.test.js || true"
  },
  "dependencies": {
    "jsdom": "^26.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "author": "BIDKAR RAMOS <bidkar@gulp.wtf>",
  "license": "Apache-2.0"
}
